{
  "name": "extract-excel",
  "version": "1.0.0-dev.1",
  "private": true,
  "description": "Command-line tool and API to extract Microsoft Excel data.",
  "author": "John Haugabook",
  "license": "MIT",
  "homepage": "https://github.com/isocialPractice/extract-excel#readme",
  "bugs": {
    "url": "https://github.com/isocialPractice/extract-excel/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isocialPractice/extract-excel.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "excel",
    "xlsx",
    "csv",
    "cli",
    "extract",
    "spreadsheet"
  ],
  "bin": {
    "extract-excel": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.json",
    "README.md",
    "scripts",
    "tests/files"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "npm run clean && npm run build",
    "postinstall": "node scripts/find-libreoffice.js",
    "install-libreoffice": "node scripts/find-libreoffice.js",
    "start": "node dist/cli.js",
    "test": "node dist/cli.js --test"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=16"
  }
}
